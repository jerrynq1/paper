// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("SDRange+", "SDR+", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

const string NY = "America/New_York"
const int DAY = 86400000

rngSess = input.session("0600-0900", "Range session", group = "Range", tooltip = "new york time. the high, low and open of this window set the levels")
shown = input.int(1, "Ranges shown", minval = 1, maxval = 10, group = "Range", tooltip = "the latest range runs to the right edge. older ones stop at the hour below")
pastHour = input.int(17, "Older ranges end (hour)", minval = 10, maxval = 23, group = "Range")
extBars = input.int(8, "Extend right (bars)", minval = 1, maxval = 50, group = "Range")
projStr = input.string("0.5 1 2 2.5", "Projections", group = "Projections", tooltip = "multiples of the range above the high and below the low. separate with spaces")
zoneOn = input.bool(true, "Shaded zone", group = "Projections", inline = "z")
zoneA = input.float(1.33, "", minval = 0.1, step = 0.01, group = "Projections", inline = "z")
zoneB = input.float(1.66, "", minval = 0.1, step = 0.01, group = "Projections", inline = "z", tooltip = "the area between these two multiples is shaded on both sides")
pzStr = input.string("0.1 0.2 0.3", "Zone lines", group = "Projections", tooltip = "thin lines outside the high and low, as fractions of the range. separate with spaces")

showHL = input.bool(true, "High / low", group = "Levels")
showMid = input.bool(true, "50%", group = "Levels")
showQuart = input.bool(true, "25% / 75%", group = "Levels")
showOpen = input.bool(false, "Range open", group = "Levels")
showProj = input.bool(true, "Projections", group = "Levels")
showPz = input.bool(true, "Zone lines", group = "Levels")
showVline = input.bool(true, "Range end line", group = "Levels")

pvOn1 = input.bool(false, "Session 1 pivots", group = "Liquidity map", inline = "p1")
pvSess1 = input.session("2000-0000", "", group = "Liquidity map", inline = "p1", tooltip = "new york time")
pvOn2 = input.bool(false, "Session 2 pivots", group = "Liquidity map", inline = "p2")
pvSess2 = input.session("0200-0500", "", group = "Liquidity map", inline = "p2", tooltip = "new york time")
pvName1 = input.string("Asia", "Names", group = "Liquidity map", inline = "n")
pvName2 = input.string("London", "", group = "Liquidity map", inline = "n")
pvBack = input.int(3, "Sessions back", minval = 1, maxval = 10, group = "Liquidity map", tooltip = "completed sessions kept for each pivot session")
pvKeep = input.bool(true, "Keep swept pivots", group = "Liquidity map", tooltip = "off removes a pivot once price trades through it. on stops the line there")

hlCol = input.color(#131722, "High / low", group = "Style", inline = "a")
midCol = input.color(#2E7D32, "50%", group = "Style", inline = "a")
quartCol = input.color(#E24B4B, "25 / 75", group = "Style", inline = "a")
projCol = input.color(#000000, "Projections", group = "Style", inline = "b")
zoneBorder = input.color(#26A65B, "Zone border", group = "Style", inline = "b")
zoneFill = input.color(color.new(#6F8F78, 78), "Zone fill", group = "Style", inline = "b")
pzCol = input.color(color.new(#F23645, 25), "Zone lines", group = "Style", inline = "b")
nameCol = input.color(#5D606B, "High / low text", group = "Style", inline = "a")
pvCol1 = input.color(#787B86, "Pivots", group = "Style", inline = "c")
pvCol2 = input.color(#089981, "", group = "Style", inline = "c")
hlWidth = input.int(2, "High / low width", minval = 1, maxval = 5, group = "Style")
showLabels = input.bool(true, "Labels", group = "Style", inline = "l")
showPrices = input.bool(false, "Prices", group = "Style", inline = "l")
textSize = input.string("Small", "Text", options = ["Tiny", "Small", "Normal", "Large"], group = "Style")
monoFont = input.bool(true, "Monospace labels", group = "Style")
tableSize = input.string("Normal", "Table text", options = ["Tiny", "Small", "Normal", "Large"], group = "Style")
showTable = input.bool(true, "Table", group = "Style", inline = "t")
tableSpot = input.string("Bottom Center", "", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Bottom Center", "Top Center"], group = "Style", inline = "t")

grey = #787B86
noFill = color.new(color.black, 100)
txt = textSize == "Tiny" ? size.tiny : textSize == "Small" ? size.small : textSize == "Normal" ? size.normal : size.large
ttxt = tableSize == "Tiny" ? size.tiny : tableSize == "Small" ? size.small : tableSize == "Normal" ? size.normal : size.large
ttxtSmall = tableSize == "Large" ? size.normal : tableSize == "Normal" ? size.small : size.tiny
barMs = timeframe.in_seconds() * 1000
chartOk = timeframe.isintraday and timeframe.in_seconds() <= 3600
inRange = not na(time(timeframe.period, rngSess, NY))
inP1 = not na(time(timeframe.period, pvSess1, NY))
inP2 = not na(time(timeframe.period, pvSess2, NY))

price(float p) => str.tostring(p, format.mintick)

parse(string s) =>
    array<float> out = array.new<float>()
    for t in str.split(str.replace_all(s, ",", " "), " ")
        float v = str.tonumber(t)
        if not na(v) and v > 0
            out.push(v)
    out

type Bag
    array<line> lines
    array<label> labels
    array<box> boxes

method clean(Bag b) =>
    for l in b.lines
        line.delete(l)
    for l in b.labels
        label.delete(l)
    for x in b.boxes
        box.delete(x)
    b.lines.clear()
    b.labels.clear()
    b.boxes.clear()
    true

newBag() => Bag.new(array.new<line>(), array.new<label>(), array.new<box>())

type Rng
    int endT
    float open
    float hi
    int hiT
    float lo
    int loT

type Pv
    float hi
    int hiT
    float lo
    int loT
    int hiSw
    int loSw

type Sess
    string name
    color col
    bool on
    bool live
    float hi
    int hiT
    float lo
    int loT
    array<Pv> done

stepSess(Sess s, bool inS, bool wasIn) =>
    if s.on and barstate.isconfirmed
        if inS and not wasIn
            s.live := true
            s.hi := high
            s.hiT := time
            s.lo := low
            s.loT := time
        else if inS and s.live
            if high > s.hi
                s.hi := high
                s.hiT := time
            if low < s.lo
                s.lo := low
                s.loT := time
        if not inS and wasIn and s.live
            s.live := false
            s.done.push(Pv.new(s.hi, s.hiT, s.lo, s.loT, na, na))
            while s.done.size() > pvBack
                s.done.shift()
        for pv in s.done
            if na(pv.hiSw) and time > pv.hiT and high > pv.hi
                pv.hiSw := time
            if na(pv.loSw) and time > pv.loT and low < pv.lo
                pv.loSw := time
    true

tag(int x, float y, string s, color c) =>
    label.new(x, y, s, xloc = xloc.bar_time, style = label.style_label_left, color = noFill, textcolor = c, size = txt, text_font_family = monoFont ? font.family_monospace : font.family_default)

seg(Bag b, int x1, int x2, float y, color c, int w, string st) =>
    b.lines.push(line.new(x1, y, x2, y, xloc = xloc.bar_time, color = c, style = st == "solid" ? line.style_solid : st == "dashed" ? line.style_dashed : line.style_dotted, width = w))
    true

lbl(Bag b, int x, float y, string s, color c) =>
    if showLabels
        b.labels.push(tag(x + barMs, y, s + (showPrices ? " " + price(y) : ""), c))
    true

var array<float> projArr = parse(projStr)
var array<float> pzArr = parse(pzStr)
var array<Rng> rngs = array.new<Rng>()
var Rng cur = na
var Bag drawBag = newBag()
var Sess s1 = Sess.new(pvName1, pvCol1, pvOn1, false, na, na, na, na, array.new<Pv>())
var Sess s2 = Sess.new(pvName2, pvCol2, pvOn2, false, na, na, na, na, array.new<Pv>())

if barstate.isconfirmed
    if inRange and not inRange[1]
        cur := Rng.new(na, open, high, time, low, time)
    else if inRange and not na(cur)
        if high > cur.hi
            cur.hi := high
            cur.hiT := time
        if low < cur.lo
            cur.lo := low
            cur.loT := time
    if not inRange and inRange[1] and not na(cur)
        cur.endT := time
        rngs.push(cur)
        while rngs.size() > shown + 10
            rngs.shift()
        cur := na

stepSess(s1, inP1, inP1[1])
stepSess(s2, inP2, inP2[1])

if barstate.islast and chartOk
    drawBag.clean()
    int right = time + extBars * barMs
    int n = math.min(shown, rngs.size())
    for k = 0 to n - 1
        Rng r = rngs.get(rngs.size() - 1 - k)
        float h = r.hi - r.lo
        if h > 0
            int x1 = r.endT
            int x2 = right
            if k > 0
                int d = timestamp(NY, year(r.endT, NY), month(r.endT, NY), dayofmonth(r.endT, NY), pastHour, 0)
                x2 := d > r.endT ? d : d + DAY
            if showVline
                drawBag.lines.push(line.new(x1, r.hi, x1, r.lo, xloc = xloc.bar_time, color = projCol, style = line.style_dotted, width = 1))
            if showHL
                seg(drawBag, r.hiT, x2, r.hi, hlCol, hlWidth, "solid")
                seg(drawBag, r.loT, x2, r.lo, hlCol, hlWidth, "solid")
                lbl(drawBag, x2, r.hi, "HIGH", nameCol)
                lbl(drawBag, x2, r.lo, "LOW", nameCol)
            if showMid
                float m = r.lo + h * 0.5
                seg(drawBag, x1, x2, m, midCol, 1, "solid")
                lbl(drawBag, x2, m, "EQ", midCol)
            if showQuart
                float q1 = r.lo + h * 0.25
                float q3 = r.lo + h * 0.75
                seg(drawBag, x1, x2, q1, color.new(quartCol, 35), 1, "dotted")
                seg(drawBag, x1, x2, q3, color.new(quartCol, 35), 1, "dotted")
                lbl(drawBag, x2, q1, "25%", quartCol)
                lbl(drawBag, x2, q3, "75%", quartCol)
            if showOpen
                seg(drawBag, x1, x2, r.open, grey, 1, "dotted")
                lbl(drawBag, x2, r.open, "RO", grey)
            if showPz
                for f in pzArr
                    seg(drawBag, x1, x2, r.hi + f * h, pzCol, 1, "dotted")
                    seg(drawBag, x1, x2, r.lo - f * h, pzCol, 1, "dotted")
            if showProj
                for p in projArr
                    string pt = str.tostring(p, "#.##")
                    seg(drawBag, x1, x2, r.hi + p * h, projCol, 1, "dotted")
                    seg(drawBag, x1, x2, r.lo - p * h, projCol, 1, "dotted")
                    lbl(drawBag, x2, r.hi + p * h, "+" + pt, projCol)
                    lbl(drawBag, x2, r.lo - p * h, "-" + pt, projCol)
            if zoneOn and zoneB > zoneA
                float uA = r.hi + zoneA * h
                float uB = r.hi + zoneB * h
                float dA = r.lo - zoneA * h
                float dB = r.lo - zoneB * h
                drawBag.boxes.push(box.new(x1, uB, x2, uA, xloc = xloc.bar_time, border_color = zoneBorder, border_style = line.style_dotted, bgcolor = zoneFill))
                drawBag.boxes.push(box.new(x1, dA, x2, dB, xloc = xloc.bar_time, border_color = zoneBorder, border_style = line.style_dotted, bgcolor = zoneFill))
                lbl(drawBag, x2, uA, "+" + str.tostring(zoneA, "#.##"), zoneBorder)
                lbl(drawBag, x2, uB, "+" + str.tostring(zoneB, "#.##"), zoneBorder)
                lbl(drawBag, x2, dA, "-" + str.tostring(zoneA, "#.##"), zoneBorder)
                lbl(drawBag, x2, dB, "-" + str.tostring(zoneB, "#.##"), zoneBorder)
    for sx in array.from(s1, s2)
        if sx.on
            for pv in sx.done
                if na(pv.hiSw) or pvKeep
                    seg(drawBag, pv.hiT, na(pv.hiSw) ? right : pv.hiSw, pv.hi, sx.col, 1, "dashed")
                    if na(pv.hiSw)
                        lbl(drawBag, right, pv.hi, sx.name + " H", sx.col)
                if na(pv.loSw) or pvKeep
                    seg(drawBag, pv.loT, na(pv.loSw) ? right : pv.loSw, pv.lo, sx.col, 1, "dashed")
                    if na(pv.loSw)
                        lbl(drawBag, right, pv.lo, sx.name + " L", sx.col)

var table board = table.new(tableSpot == "Top Right" ? position.top_right : tableSpot == "Bottom Right" ? position.bottom_right : tableSpot == "Top Left" ? position.top_left : tableSpot == "Bottom Left" ? position.bottom_left : tableSpot == "Top Center" ? position.top_center : position.bottom_center, 3, 1, border_width = 1, border_color = #E4E4E4, frame_width = 2, frame_color = color.black)

if barstate.islast and showTable
    table.clear(board, 0, 0, 2, 0)
    table.cell(board, 0, 0, "Range", text_color = color.white, bgcolor = #555555, text_size = ttxt, text_formatting = text.format_bold)
    table.cell(board, 1, 0, rngSess, text_color = color.black, bgcolor = #F0F0F0, text_size = ttxt)
    string sizeTxt = rngs.size() > 0 ? str.tostring(rngs.last().hi - rngs.last().lo, format.mintick) : "-"
    table.cell(board, 2, 0, sizeTxt, text_color = #555555, bgcolor = #EEEEEE, text_size = ttxtSmall, text_font_family = font.family_monospace, tooltip = "size of the latest range")
